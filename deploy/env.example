# Backend database connection
DB_URL=jdbc:postgresql://postgres:5432/dt_control_power
DB_USERNAME=dt_control_power
DB_PASSWORD=replace-me-outside-git

# Demo identity provisioning (synthetic accounts only)
DEMO_ADMIN_PASSWORD=replace-me-outside-git
DEMO_OPERATOR_PASSWORD=replace-me-outside-git
DEMO_AUDITOR_PASSWORD=replace-me-outside-git

# Set true only when the application is served through HTTPS
SESSION_COOKIE_SECURE=false

# Private persistent volume; never expose this directory through NGINX
FILE_STORAGE_PATH=/var/lib/dt-control-power/uploads

# Spring Boot structured console format; keep parseable for log ingestion
LOGGING_STRUCTURED_FORMAT_CONSOLE=logstash
