# Existing PostgreSQL 17 on process-observability_default.
DB_URL=jdbc:postgresql://postgres:5432/observability
DB_USERNAME=observability
DB_PASSWORD=

# Existing infrastructure selectors used by the manual scripts.
POSTGRES_CONTAINER=process-observability-postgres-1
POSTGRES_NETWORK=process-observability_default
UPLOADS_HOST_PATH=
JAVA_TOOL_OPTIONS=-Xms128m -Xmx768m -XX:MaxMetaspaceSize=256m
# deploy.sh replaces this with the current 12-character Git commit for the image tag.
APP_VERSION=local

# Demo identity provisioning (synthetic accounts only)
DEMO_ADMIN_PASSWORD=
DEMO_OPERATOR_PASSWORD=
DEMO_AUDITOR_PASSWORD=

# Set true only when the application is served through HTTPS
SESSION_COOKIE_SECURE=false

# Spring Boot structured console format; keep parseable for log ingestion
LOGGING_STRUCTURED_FORMAT_CONSOLE=logstash
